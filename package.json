	"files": [
		"src"
	],
	"keywords": [
		"nodejs",
		"config",
		"typescript",
		"xo",
		"dprint"
	],
	"dependencies": {
		"@tommy-mitchell/dprint-config": "^0.10.0",
		"@tommy-mitchell/eslint-config-xo": "^2.0.0-beta.11",
		"@tommy-mitchell/tsconfig": "^4.0.0",
		"strip-comments-js": "^1.4.0"
	},
	"devDependencies": {
		"tsdown": "^0.23.0"
	},
	"peerDependencies": {
		"dprint": "0.x",
		"tsdown": "0.x",
		"typescript": "~6",
		"xo": "5.x"
	},
	"peerDependenciesMeta": {
		"tsdown": {
			"optional": true
		}
	}
