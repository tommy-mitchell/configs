{
	"name": "@tommy-mitchell/configs",
	"version": "0.2.0",
	"description": "TypeScript, xo, and dprint configs.",
	"license": "MIT",
	"repository": "tommy-mitchell/configs",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"./dprint": "./src/dprint.json",
		"./ts": "./src/tsconfig.json",
